{
  "name": "@howarewoo/pi-subagents",
  "version": "0.3.3",
  "description": "Pi subagent extension for supervised coding tasks with live monitoring, steering, and explicit tool permissions.",
  "keywords": [
    "agent-delegation",
    "multi-agent",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "subagent",
    "subagents"
  ],
  "homepage": "https://github.com/howarewoo/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/howarewoo/pi-subagents/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howarewoo/pi-subagents.git"
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "exercise": "node examples/sdk-exercise.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run exercise",
    "test:package": "node scripts/test-package.mjs",
    "release:check": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
